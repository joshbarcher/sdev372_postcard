# Copy to /etc/postcard.env on the server. NEVER commit the real one.
#
#   sudo cp deploy/postcard.env.example /etc/postcard.env
#   sudo nano /etc/postcard.env
#   sudo chown root:root /etc/postcard.env
#   sudo chmod 600 /etc/postcard.env        <- the whole point
#
# 0600 means root can read it and nobody else can -- not your user, not the
# service's user, not another student on a shared box. systemd reads it as root
# before it drops to User=, which is why the service still gets the values.

ADMIN_TOKEN=change-me

# Leave DATABASE_URL commented out and postcards live in memory: they work, and
# they vanish on restart. Uncomment it once MySQL is installed and they persist,
# with no change to the application.
# DATABASE_URL=mysql://postcard:s3cr3t@127.0.0.1:3306/postcard

APP_VERSION=1.0.0
NODE_ENV=production
